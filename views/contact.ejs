
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css">
  <link rel="stylesheet" href="/content/app.css">

  <script src="/bootstrap/dist/js/bootstrap.min.js" defer></script>
</head>

<body>

  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

      <a class="navbar-brand" href="/home">My Portfolio</a>

      <button class="navbar-toggler" type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent"
        aria-expanded="false"
        aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

          <!-- Home -->
          <li class="nav-item">
            <% if (title == "Home page") { %>
              <a class="nav-link active" aria-current="page" href="/home">
                Home <i class="fa-solid fa-house"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/home">
                Home <i class="fa-solid fa-house"></i>
              </a>
            <% } %>
          </li>

          <!-- About -->
          <li class="nav-item">
            <% if (title == "About Me") { %>
              <a class="nav-link active" aria-current="page" href="/about">
                About <i class="fa-solid fa-person"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/about">
                About <i class="fa-solid fa-person"></i>
              </a>
            <% } %>
          </li>

          <!-- Projects -->
          <li class="nav-item">
            <% if (title == "My Projects" || title == "Projects page") { %>
              <a class="nav-link active" aria-current="page" href="/projects">
                Projects <i class="fa-solid fa-book"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/projects">
                Projects <i class="fa-solid fa-book"></i>
              </a>
            <% } %>
          </li>

          <!-- Contact -->
          <li class="nav-item">
            <% if (title == "Contact Me") { %>
              <a class="nav-link active" aria-current="page" href="/contact">
                Contact <i class="fa-solid fa-phone"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/contact">
                Contact <i class="fa-solid fa-phone"></i>
              </a>
            <% } %>
          </li>

        </ul>
      </div>
    </div>
  </nav>

  <!-- Contact Form -->
  <main class="container my-5">

    <h1>Contact Me</h1>
    <p>Feel free to contact me using the form below.</p>

    <form action="/contact" method="post">

      <!-- First Name -->
      <div class="mb-3">
        <label for="firstname" class="form-label">First Name</label>
        <input type="text" class="form-control"
          id="firstname" name="firstname"
          placeholder="Enter your first name" required>
      </div>

      <!-- Last Name -->
      <div class="mb-3">
        <label for="lastname" class="form-label">Last Name</label>
        <input type="text" class="form-control"
          id="lastname" name="lastname"
          placeholder="Enter your last name" required>
      </div>

      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" class="form-control"
          id="email" name="email"
          placeholder="name@example.com" required>
      </div>

      <!-- Message -->
      <div class="mb-3">
        <label for="message" class="form-label">Message</label>
        <textarea class="form-control"
          id="message" name="message"
          rows="4"
          placeholder="Enter your message" required></textarea>
      </div>

      <!-- Submit Button -->
      <div class="mb-3">
        <button type="submit" class="btn btn-primary">
          Submit
        </button>
      </div>

    </form>

  </main>

  <script src="/script/app.js"></script>

</body>
</html>
