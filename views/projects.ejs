  <div class="row row-cols-1 row-cols-md-2 g-4">

    <!-- Project 1 -->
    <div class="col">
      <div class="card h-100">
        <div class="card-header">
          <i class="fa-solid fa-business-time" style="color: rgb(175, 19, 0);"></i>
          Business Proposal / Plan
        </div>
        <div class="card-body">
          <p class="card-text">
            I created a business plan for a local cafe named
