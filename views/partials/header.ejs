<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css">
  <link rel="stylesheet" href="/content/app.css">

  <script src="/bootstrap/dist/js/bootstrap.min.js" defer></script>
</head>

<body>

  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

      <a class="navbar-brand" href="/home">My Portfolio</a>

      <button class="navbar-toggler" type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent"
        aria-expanded="false"
        aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

          <!-- Home -->
          <li class="nav-item">
            <% if (title == "Home page") { %>
              <a class="nav-link active" aria-current="page" href="/home">
                Home <i class="fa-solid fa-house"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/home">
                Home <i class="fa-solid fa-house"></i>
              </a>
            <% } %>
          </li>

          <!-- About -->
          <li class="nav-item">
            <% if (title == "About Me") { %>
              <a class="nav-link active" aria-current="page" href="/about">
                About <i class="fa-solid fa-person"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/about">
                About <i class="fa-solid fa-person"></i>
              </a>
            <% } %>
          </li>

          <!-- Projects -->
          <li class="nav-item">
            <% if (title == "My Projects" || title == "Projects page") { %>
              <a class="nav-link active" aria-current="page" href="/projects">
                Projects <i class="fa-solid fa-book"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/projects">
                Projects <i class="fa-solid fa-book"></i>
              </a>
            <% } %>
          </li>

          <!-- Contact -->
          <li class="nav-item">
            <% if (title == "Contact Me") { %>
              <a class="nav-link active" aria-current="page" href="/contact">
                Contact <i class="fa-solid fa-phone"></i>
              </a>
            <% } else { %>
              <a class="nav-link" href="/contact">
                Contact <i class="fa-solid fa-phone"></i>
              </a>
            <% } %>
          </li>

        </ul>
      </div>
    </div>
  </nav>